# ============================================================================
# ShopNow Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your environment
# Never commit .env to version control
# ============================================================================

# ============================================================================
# RabbitMQ Configuration
# ============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# RabbitMQ Management UI
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_USER=guest
RABBITMQ_MANAGEMENT_PASS=guest

# ============================================================================
# JWT Authentication Configuration
# ============================================================================
# SECRET_KEY: Change this in production to a strong random key
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=shopnow-secret-key-2024-change-in-production

# JWT Algorithm
ALGORITHM=HS256

# Token expiration in minutes
# Default: 480 minutes (8 hours)
EXPIRATION_MINUTES=480

# ============================================================================
# Service Configuration
# ============================================================================

# Clientes Service
CLIENTES_PORT=8000
CLIENTES_HOST=0.0.0.0
CLIENTES_RELOAD=true

# Productos Service
PRODUCTOS_PORT=8001
PRODUCTOS_HOST=0.0.0.0
PRODUCTOS_RELOAD=true

# Pedidos Service
PEDIDOS_PORT=8002
PEDIDOS_HOST=0.0.0.0
PEDIDOS_RELOAD=true

# Inventario Service
INVENTARIO_PORT=8003
INVENTARIO_HOST=0.0.0.0
INVENTARIO_RELOAD=true

# Productos PHP Service
PRODUCTOS_PHP_PORT=8081
PRODUCTOS_PHP_HOST=0.0.0.0

# ============================================================================
# Database Configuration (PostgreSQL - Required)
# ============================================================================
# Configure your PostgreSQL database connection
# For Render: Find credentials in Render Dashboard → PostgreSQL → Connection details
DATABASE_HOST=your_postgres_host_here
DATABASE_USER=your_postgres_user
DATABASE_PASS=your_postgres_password
DATABASE_PORT=5432
DATABASE_NAME=your_database_name

# ============================================================================
# Redis Configuration (optional, for caching)
# ============================================================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# Deployment Configuration
# ============================================================================

# Environment type
ENVIRONMENT=development
# Options: development, staging, production

# Enable debug mode (NEVER in production)
DEBUG=false

# CORS Origins
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ============================================================================
# Railway.app Cloud Deployment
# ============================================================================
# Uncomment when deploying to Railway

# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=your_project_id
# RAILWAY_TOKEN=your_railway_token

# ============================================================================
# GitHub Actions / CI-CD
# ============================================================================
# For automated testing and deployment

# GITHUB_TOKEN=your_github_token
# DOCKER_REGISTRY_USERNAME=your_username
# DOCKER_REGISTRY_PASSWORD=your_password

# ============================================================================
# Monitoring & Observability
# ============================================================================
# SENTRY_DSN=https://your-sentry-url
# DATADOG_API_KEY=your_datadog_key
# NEW_RELIC_LICENSE_KEY=your_newrelic_key

# ============================================================================
# SECURITY WARNING
# ============================================================================
# IMPORTANT: Never commit this file to version control!
# Add .env to .gitignore
# Use .env.example as template for others
# Always use strong, random values in production
# Rotate secrets regularly
# ============================================================================
